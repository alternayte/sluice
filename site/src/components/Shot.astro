---
// Shot shows a screenshot of the app in the theme of the page. `just docs-shots` writes the
// light and dark pictures to src/assets/shots/<name>-light.png and <name>-dark.png.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  name: string;
  alt: string;
  caption?: string;
}

const shots = import.meta.glob<{ default: ImageMetadata }>("../assets/shots/*.png", { eager: true });
const { name, alt, caption } = Astro.props;
const light = shots[`../assets/shots/${name}-light.png`];
const dark = shots[`../assets/shots/${name}-dark.png`];
if (!light || !dark) throw new Error(`Shot "${name}" does not exist. Run \`just docs-shots\`.`);
---

<figure class="shot">
  <Image src={light.default} alt={alt} class="dark:sl-hidden" widths={[720, 1440]} sizes="(min-width: 50rem) 46rem, 100vw" />
  <Image src={dark.default} alt={alt} class="light:sl-hidden" widths={[720, 1440]} sizes="(min-width: 50rem) 46rem, 100vw" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .shot {
    margin-block: 1.5rem;
  }
  .shot figcaption {
    margin-top: 0.5rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
</style>
