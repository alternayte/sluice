{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "@playwright/test"]
  },
  "include": ["specs/**/*.ts", "helpers/**/*.ts", "global-setup.ts", "global-teardown.ts", "playwright.config.ts"]
}
